# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files with LF line endings
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.tcss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.vsix binary
*.whl binary
*.pyc binary
*.pyd binary
*.sqlite* binary
*.exe binary
*.dll binary
