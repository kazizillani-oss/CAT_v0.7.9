  "cards": [
    {
      "dot": "emerald",
      "title": "Node.js Identity & Passkeys",
      "items": [
        "Express server on port 3000 handles WebAuthn passkeys",
        "Exchanges credentials for 0600 token in ~/.fomoji/connectors/cat.json",
        "CAT Browser syncs session automatically"
      ]
    },
    {
      "dot": "cyan",
      "title": "Autonomous Workflow Engine",
      "items": [
        "Orchestrates end-to-end task decomposition and multi-agent flows",
        "LiveActivities broadcasts point-to-point data events across TUI and Web",
        "Full lineage tracking ensures reproducible task execution"
      ]
    },
    {
      "dot": "violet",
      "title": "Web Developing & Live Preview",
      "items": [
        "FastAPI web server (:8765) powers browser assistant and web preview",
        "WebSocket message bus delivers instantaneous token streaming",
        "Devserver mounts workspace previews with hot-reloading"
      ]
    },
    {
      "dot": "amber",
      "title": "Data Lineage & Storage Layer",
      "items": [
        "SQLite database stores identity records and connector tokens",
        "Workspace watchdog watches source code files with zero CPU overhead",
        "Git lineage ledger records commit checkpoints and session snapshots"
      ]
    }
  ]
}