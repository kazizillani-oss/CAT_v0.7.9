# CAT — Python packaging / local dev ignores (never commit these).
# The wheel/sdist are build artifacts: rebuild with `python -m build`.
dist/
build/
*.egg-info/
CAT_v0.7.4/*.egg-info/
*.whl
*.tar.gz
*.vsix

# VS Code extension development / testing
node_modules/
cat-cli/node_modules/
cat-cli/.vscode-test/
cat-cli/.tmp-workspace/
.vscode-test/

# Virtual environments & Environment Variables (never commit live secrets).
.venv*/
venv*/
.env*/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example
!*.env.sample
!*.env.template

