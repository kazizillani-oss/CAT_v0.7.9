dist/
build/
*.egg-info/
CAT_v0.7.4/*.egg-info/
*.whl
*.tar.gz
*.vsix

# VS Code extension development / testing
node_modules/
cat-cli/node_modules/
cat-cli/.vscode-test/
cat-cli/.tmp-workspace/
.vscode-test/

# Virtual environments (clean-venv tests create these; keep them local).
.venv*/
venv*/
.env*/
.env
*.env
*.env.*
!*.env.example
!*.env.sample

