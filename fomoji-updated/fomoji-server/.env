# Copy of .env.example with defaults for local development
PORT=3000

# WebAuthn ties every passkey to this exact domain. "localhost" works out of
# the box for local dev (browsers treat it as a secure context).
RP_ID=localhost
RP_NAME=Fomoji

# Must be the exact origin (scheme + host + port) users load the site from.
ORIGIN=http://localhost:3000

# Development session secret
SESSION_SECRET=dev-only-secret-change-me

# Identity providers (Google/Apple/Microsoft/GitHub/Facebook OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
