# Copy to .env and adjust for your environment.

PORT=3000

# WebAuthn ties every passkey to this exact domain. "localhost" works out of
# the box for local dev (browsers treat it as a secure context). In
# production this MUST be your real domain, e.g. RP_ID=fomoji.app
RP_ID=localhost
RP_NAME=Fomoji

# Must be the exact origin (scheme + host + port) users load the site from.
ORIGIN=http://localhost:3000

# Required in production — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me

# ---------------------------------------------------------------------
# Identity providers (Google/Apple/Microsoft/GitHub/Facebook OAuth).
# Leave any pair blank/unset and that provider shows as "Not configured"
# in the UI instead of pretending to work — nothing here is required to
# run Fomoji with passkeys/password only.
#
# Every *_CLIENT_SECRET here is an opaque string issued by the provider —
# never something Fomoji generates itself.
#
# Redirect URI to register with EVERY provider below:
#   {ORIGIN}/api/oauth/<provider>/callback
#   e.g. http://localhost:3000/api/oauth/google/callback in local dev,
#   or https://your-domain.example/api/oauth/google/callback once deployed.
# ---------------------------------------------------------------------

# console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developer.apple.com → Certificates, Identifiers & Profiles → Services ID.
# APPLE_CLIENT_SECRET is NOT a normal secret — it's a JWT you generate
# yourself, signed with your Sign in with Apple private key (.p8), valid
# up to 6 months. Regenerate and update this value before it expires.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# entra.microsoft.com (Azure AD) → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# developers.facebook.com → your app → Settings → Basic
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
