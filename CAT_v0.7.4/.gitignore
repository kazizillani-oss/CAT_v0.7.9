# CAT — Local dev & secret ignores
dist/
build/
*.egg-info/
*.whl
*.tar.gz
*.vsix

.venv*/
venv*/
.env*/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example
!*.env.sample
!*.env.template

# Secret keys, private certificates & tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.p8
*.id_rsa
*.id_ecdsa
*.id_ed25519
.pypirc
credentials.json
client_secret*.json
service-account*.json
token.json
*.token
.fomoji/
**/.fomoji/
**/.cct_auth*.json

# Bytecode / caches.
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.tmp
*.bak

# Runtime caches and databases
cache/
staged/
workspaces/
startup.log
*.log
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
