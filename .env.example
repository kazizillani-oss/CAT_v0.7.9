# ==============================================================================
# CAT CLI & Fomoji Identity Server — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local configuration.
# NEVER commit your actual `.env` file or any real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider API Keys (Set any that you use; CAT will auto-detect)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# Generic CAT fallback key
CAT_API_KEY=

# Local Ollama endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. Database Connection Strings (Environment variables only — never hardcoded)
# ------------------------------------------------------------------------------
# Example PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=
# Example MongoDB: mongodb+srv://user:password@cluster.mongodb.net/dbname
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. Supabase Credentials
# NOTE: The anon key is client-safe ONLY when Row Level Security (RLS) is
# enabled on all tables. The service_role key must NEVER be exposed to clients.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Stripe Keys
# NOTE: Publishable key is safe for client-side; secret key must stay server-side.
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. Third-Party Cloud, Email & Notification Services
# ------------------------------------------------------------------------------
# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SendGrid Email API
SENDGRID_API_KEY=

# Twilio SMS / Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Firebase
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# ------------------------------------------------------------------------------
# 6. Fomoji Identity Server & Authentication Configuration
# ------------------------------------------------------------------------------
PORT=3000
RP_ID=localhost
RP_NAME=Fomoji
ORIGIN=http://localhost:3000

# Required in production: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
CARD_SECRET=

# Server-to-server secret for connector application registration
CONNECTOR_REGISTRATION_SECRET=

# ------------------------------------------------------------------------------
# 7. OAuth Provider Credentials (Server-side only)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple client secret is a JWT generated from your Apple Developer Private Key (.p8)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. CAT CLI Application Settings
# ------------------------------------------------------------------------------
CAT_STORAGE_DIR=
CAT_USER_EMAIL=
CAT_ECO_MODE=0
FOMOJI_URL=http://localhost:3000
